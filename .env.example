# Noa runtime configuration — copy to `.env` and edit.
# This single file configures every sibling (the tools read these env vars).

# --- Ollama (runs on the HOST; Noa does not manage it) ---
# The HTTP endpoint every tool uses. Point at your host Ollama.
OLLAMA_BASE_URL=http://localhost:11434
# Only needed by the `ollama_cli` adapters that shell out to the binary. On a
# normal install `ollama` is on PATH; under WSL pointing at the Windows binary:
#   OLLAMA_EXECUTABLE=/mnt/c/Users/<you>/AppData/Local/Programs/Ollama/ollama.exe
OLLAMA_EXECUTABLE=ollama

# --- MongoDB (the compose service) ---
MONGO_PORT=27017
MONGO_URI=mongodb://localhost:27017
# Each tool keeps its own database in the one mongod.
MAHALATH_MONGO_URI=mongodb://localhost:27017
MAHALATH_MONGO_DB=mahalath_dev
TIRZAH_MONGO_URI=mongodb://localhost:27017
TIRZAH_MONGO_DB=mnemosyne_dev

# --- Real LLM + embeddings via the Hoglah queue (Noa default) ---
# Both tools route model + embedding calls through a Hoglah worker daemon that
# install.sh starts. Aligned on Hoglah's default paths so submitters and the daemon
# agree without per-tool path config. (Set MAHALATH_MODEL_ADAPTER=ollama_http to go
# direct to Ollama instead — no daemon.)
HOGLAH_QUEUE_DIR=${HOME}/.hoglah
HOGLAH_DB_PATH=${HOME}/.hoglah/hoglah.db
HOGLAH_OUTPUT_DIR=${HOME}/.hoglah/outbox
HOGLAH_OLLAMA_HOST=http://localhost:11434
HOGLAH_CONCURRENCY=1
# Mahalath routes through Hoglah (gen + embeddings); Tirzah is set in its config.
MAHALATH_MODEL_ADAPTER=hoglah
MAHALATH_EMBEDDING_MODEL=bge-m3:latest
# Real embeddings for Tirzah ingestion (rendered into its config). bge-m3 = 1024-dim.
EMBEDDING_MODEL=bge-m3:latest
EMBEDDING_DIMENSIONS=1024

# --- Semantic precision (Tirzah -> Mahalath seam) ---
# Enable the resolver for this profile so retrieval resolves terms to live MPL
# labels. MAHALATH_MONGO_URI/DB above tell Tirzah where Mahalath's ontology lives.
MAHALATH_ENABLED=true
# Strict: keep only confident label/exact/alias matches, drop fuzzy approximations
# (precision-grade default; set false to accept approximate hints).
MAHALATH_STRICT=true

# --- Tool config locations (so they don't depend on cwd) ---
# install.sh renders this file from the values above. Tirzah also reads the
# MAHALATH_* env vars directly, so the seam works whether or not this file exists.
TIRZAH_CONFIG=${HOME}/ai-stack/config/tirzah.config.yaml
